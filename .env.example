# Copy to .env (gitignored) and fill in real values.
# Loaded automatically at `import afriscience_mt`.

OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
# TOGETHER_API_KEY=...

# Brevo transactional email — used by scripts/rerun_*.py for progress
# notifications (start / every N configs / success / failure).
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=you@verified-sender.example   # must be a verified Brevo sender
